# Copy this file to .env for local dev (`vercel dev` and `npm run migrate`
# both read it). Never commit the real .env — it's already in .gitignore.

# Neon Postgres connection string. Use the POOLED connection string from
# your Neon project's dashboard (Connection Details -> "Pooled connection")
# — it has -pooler in the hostname and includes ?sslmode=require. The
# pooled string is what api/_db.js should use in serverless functions;
# the direct (non-pooled) string is fine for running `npm run migrate`
# from your own machine.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/neondb?sslmode=require

# Shared password that unlocks Add/Edit/Delete in the app (viewers without
# it get read-only access). Enforced server-side in api/_auth.js. Pick
# anything reasonably long — it's checked, not stored in plaintext anywhere
# but this env var and the request header.
EDITOR_PASSWORD=change-me
